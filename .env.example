# ==============================================================================
# CallMate AI - Environment Configuration Template
# ==============================================================================

# Application Information (Phase 1)
APP_NAME="CallMate AI"
APP_VERSION="0.2.0"
ENVIRONMENT="development"  # Options: development, staging, production, test
DEBUG=false

# Server Networking
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Logging Configuration
LOG_LEVEL="INFO"          # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="console"      # Options: console (human-readable), json (structured production)

# Security & Secrets (Phase 2)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string"
OWNER_API_KEY="replace-with-a-secure-owner-api-key"

# Receptionist Persona & Owner Identity (Phase 2)
# RECEPTIONIST_OWNER_NAME MUST be configured before voice sessions can be created.
RECEPTIONIST_OWNER_NAME=""
RECEPTIONIST_NAME="CallMate"

# Gemini Live AI Voice Engine (Phase 2)
GEMINI_API_KEY="replace-with-your-google-gemini-api-key"
GEMINI_MODEL="gemini-3.8-live"
GEMINI_API_VERSION="v1alpha"  # Required for Gemini Live bidirectional WebSocket streaming
GEMINI_VOICE_NAME="Aoede"  # Options: Aoede, Kore, Puck, Charon, Fenrir
GEMINI_TEMPERATURE=0.6

# Session & Rate Limiting (Phase 2 - Development In-Memory)
MAX_ACTIVE_VOICE_SESSIONS=25
SESSION_TOKEN_TTL_SECONDS=300
SESSION_RATE_LIMIT_PER_MINUTE=10
MESSAGE_STORAGE_PATH="data/messages"

# Security & CORS
ALLOWED_HOSTS='["*"]'
CORS_ORIGINS='["*"]'
